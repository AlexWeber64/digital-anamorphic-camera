<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnamorphicStretchCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Compact, high-contrast segmented-control button used for the Stretch/Squeeze mode
         selector. The Video/Photo selector deliberately does NOT use this style - it's plain
         unboxed text (see activity_main.xml), matching native camera apps' minimal mode chrome. -->
    <style name="Widget.AnamorphicCam.ModeButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeColor">@color/chrome_stroke</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
</resources>
